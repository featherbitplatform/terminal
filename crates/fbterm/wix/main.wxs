<?xml version='1.0' encoding='windows-1252'?>
<!--
  featherbit terminal installer (WiX Toolset v3), built by `cargo wix` from
  dev/package-windows.ps1. Based on the default template of cargo-wix 0.3.9
  (Copyright (C) 2017 Christopher R. Field, Apache-2.0).

  - Per machine, under "Program Files\featherbit terminal" (needs administrator rights).
  - Start menu shortcut "featherbit terminal"; no desktop shortcut, no PATH change.
  - Uninstalling removes only what was installed: the user's config folder
    (%APPDATA%\featherbit\fbterm\config, with settings, profiles and secrets.dpapi)
    is never part of the package and stays.
  - The UpgradeCode below is fixed forever: every release shares it, so a newer
    version replaces an older one (MajorUpgrade). Never change it.

  Variables set by `cargo wix`: Version (X.Y.Z), CargoTargetBinDir (target\release).
  ConptyDir is added by dev/package-windows.ps1, which stages the files below into that same
  release folder and sends it to the WiX compiler as a lowercase -d define through cargo wix's
  -C option. sys.SOURCEFILEDIR is this folder, so the paths below do not depend on the working
  directory.

  The four files under ConptyDir are Microsoft's open-source ConPTY host and the license and
  third-party notices of the microsoft/terminal release they were built from, fetched and hash
  checked by dev/fetch-conpty.ps1 (its own variables hold the package version, its SHA-256 and the
  tag). portable-pty prefers a conpty.dll in its own executable's folder over the system console
  layer, and that choice is what lets a local shell's kitty APC and sixel DCS images survive: the
  system one drops them (measured by ci.yml's "ConPTY passthrough (bundled)" step). See LICENSES.md.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='featherbit terminal'
        UpgradeCode='D2F13F2B-68C8-4ED4-9953-D6E612A1FA8D'
        Manufacturer='featherbit'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='featherbit terminal: an SSH-first terminal'
            Manufacturer='featherbit'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <!--
          A newer version replaces an older one. Same-version upgrades are allowed so a
          release replaces its own pre-release (MSI compares only X.Y.Z).
          light reports warning ICE61 for AllowSameVersionUpgrades. It is expected: the same-version
          upgrade is the point, so leave it.
        -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='featherbit terminal Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='featherbit terminal'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            Name='LICENSE.txt'
                            DiskId='1'
                            Source='$(sys.SOURCEFILEDIR)..\..\..\LICENSE'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='fbterm.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\fbterm.exe'
                            KeyPath='yes'>
                            <!--
                              Declared advertised and turned into a plain shortcut by
                              DISABLEADVTSHORTCUTS below: a per-machine file stays the
                              component's key path (no per-user registry value) and the
                              shortcut takes its icon from fbterm.exe (build.rs embeds it).
                            -->
                            <Shortcut
                                Id='StartMenuShortcut'
                                Directory='ProgramMenuFolder'
                                Name='featherbit terminal'
                                Description='SSH-first terminal'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Advertise='yes'/>
                        </File>
                    </Component>
                    <!--
                      Microsoft's open-source ConPTY host, staged beside the release exe by
                      dev/package-windows.ps1 (that folder arrives here as $(var.ConptyDir)), with
                      the license and third-party notices of the microsoft/terminal release they were
                      built from: redistributing those binaries carries NOTICE.md's obligations.
                      portable-pty sideloads a conpty.dll in its own executable's folder, so local
                      shells run under it rather than under the system console layer, which drops
                      the kitty APC and sixel DCS image sequences. Each file is its own Component:
                      MSI installs and removes a whole Component at a time.
                    -->
                    <Component Id='ConptyDll' Guid='*'>
                        <File Id='conptyDll'
                            Name='conpty.dll'
                            DiskId='1'
                            Source='$(var.ConptyDir)\conpty.dll'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='OpenConsoleHost' Guid='*'>
                        <File Id='openConsole'
                            Name='OpenConsole.exe'
                            DiskId='1'
                            Source='$(var.ConptyDir)\OpenConsole.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='ConptyLicense' Guid='*'>
                        <File Id='conptyLicense'
                            Name='conpty-LICENSE.txt'
                            DiskId='1'
                            Source='$(var.ConptyDir)\conpty-LICENSE.txt'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='ConptyNotice' Guid='*'>
                        <File Id='conptyNotice'
                            Name='conpty-NOTICE.md'
                            DiskId='1'
                            Source='$(var.ConptyDir)\conpty-NOTICE.md'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'/>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs featherbit terminal, its Start menu shortcut, the license, and the bundled ConPTY host with its license and notices.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ConptyDll'/>
            <ComponentRef Id='OpenConsoleHost'/>
            <ComponentRef Id='ConptyLicense'/>
            <ComponentRef Id='ConptyNotice'/>
        </Feature>

        <Property Id='DISABLEADVTSHORTCUTS' Value='1'/>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Apps and features (Add/Remove Programs): icon, links and publisher details. -->
        <Icon Id='fbterm.ico' SourceFile='$(sys.SOURCEFILEDIR)..\windows\fbterm.ico'/>
        <Property Id='ARPPRODUCTICON' Value='fbterm.ico'/>
        <Property Id='ARPHELPLINK' Value='https://featherbitplatform.github.io/terminal/'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/featherbitplatform/terminal'/>
        <Property Id='ARPURLUPDATEINFO' Value='https://github.com/featherbitplatform/terminal/releases'/>
        <Property Id='ARPCOMMENTS' Value='SSH-first terminal with saved profiles, tabs, split panes, tunnels and a file panel.'/>
        <Property Id='ARPNOMODIFY' Value='1'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <!-- No license agreement dialog: Welcome goes straight to the folder choice. -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
